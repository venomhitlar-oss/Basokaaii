# =================================================================
# Basoka AI — Environment Configuration Template
# Copy this file to .env and configure your secret keys.
# NEVER commit your actual .env file or API keys to GitHub!
# =================================================================

# Google Gemini API Key (Required for server-side AI processing)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Application Host URL (Optional, defaults to local port 3000)
APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="production"
PORT=3000
